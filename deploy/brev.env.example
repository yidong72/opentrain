OPEN_TRAIN_AUTH_MODE=accounts
OPEN_TRAIN_PUBLIC_URL=https://opentrain.example.com
# Register these callbacks with your own OAuth applications:
# https://opentrain.example.com/auth/callback/google
# https://opentrain.example.com/auth/callback/github
OPEN_TRAIN_GOOGLE_CLIENT_ID=
OPEN_TRAIN_GOOGLE_CLIENT_SECRET=
OPEN_TRAIN_GITHUB_CLIENT_ID=
OPEN_TRAIN_GITHUB_CLIENT_SECRET=
OPEN_TRAIN_ADMIN_EMAILS=
# Leave the legacy server-wide API key unset. Users create their own keys after login.
OPEN_TRAIN_API_KEY=
