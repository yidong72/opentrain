# Use HTTPS outside localhost. Copy to .env for Docker Compose.
OPEN_TRAIN_PUBLIC_URL=http://127.0.0.1:8080
OPEN_TRAIN_AUTH_MODE=accounts
# Register these callbacks with the providers:
# http://127.0.0.1:8080/auth/callback/google
# http://127.0.0.1:8080/auth/callback/github
OPEN_TRAIN_GOOGLE_CLIENT_ID=
OPEN_TRAIN_GOOGLE_CLIENT_SECRET=
OPEN_TRAIN_GITHUB_CLIENT_ID=
OPEN_TRAIN_GITHUB_CLIENT_SECRET=
# Verified email addresses to grant server-wide administration at first signup.
OPEN_TRAIN_ADMIN_EMAILS=
# Optional legacy key grants server-wide administration. Prefer per-user keys.
OPEN_TRAIN_API_KEY=
